# 后端服务
PORT=8787
CACHE_TTL_SECONDS=120
PROVIDER_TIMEOUT_MS=10000

# 可选：只显示规则判断为特殊的航班。设为 true 可在调试时显示全部到港航班。
INCLUDE_ALL_FLIGHTS=false

# FlightAware AeroAPI v4
# 申请地址：https://www.flightaware.com/commercial/aeroapi/
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi

# Flightradar24 API
# 申请地址：https://fr24api.flightradar24.com/
FR24_API_TOKEN=
FR24_BASE_URL=https://fr24api.flightradar24.com/api

# 飞常准 VariFlight Flight Status Query V3
# APP ID、注册安全码和服务器 IP 白名单由飞常准提供。
VARIFLIGHT_APP_ID=
VARIFLIGHT_APP_SECURITY=
VARIFLIGHT_BASE_URL=https://open-al.variflight.com/api/flight

