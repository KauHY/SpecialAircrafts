# 后端服务
PORT=8787
CACHE_TTL_SECONDS=43200
STALE_CACHE_TTL_SECONDS=86400
PROVIDER_TIMEOUT_MS=10000

# 可选：只显示规则判断为特殊的航班。设为 true 可在调试时显示全部到港航班。
INCLUDE_ALL_FLIGHTS=false

# 默认不调用任何商业供应商，避免旧密钥意外产生费用。确需聚合时再设为 true。
ENABLE_COMMERCIAL_PROVIDERS=false

# 推荐主数据源：AeroDataBox（RapidAPI FREE，长期免费但有月度额度）
# 申请地址：https://rapid.aerodatabox.com/pricing
AERODATABOX_RAPIDAPI_KEY=0279b95e6amshd6ae9a68b08f905p1ab703jsn71193d39c80a
AERODATABOX_BASE_URL=https://aerodatabox.p.rapidapi.com
AERODATABOX_RAPIDAPI_HOST=aerodatabox.p.rapidapi.com

# 免费档官方额度为 600 API units/月。项目默认只允许使用 500 units，预留安全余量。
# FIDS 是 Tier 2，每次请求按 2 units 记账；完整一天需两个 12 小时请求，共 4 units。
AERODATABOX_MONTHLY_UNIT_BUDGET=500
AERODATABOX_FIDS_UNIT_COST=2

# 无需密钥的 ADS-B 候选补充。只查询已经命中特别规则且缺少注册号/机型的少量航班。
ADSB_LOL_ENABLED=true
ADSB_LOL_BASE_URL=https://api.adsb.lol
ADSB_LOL_CACHE_TTL_SECONDS=900
ADSB_LOL_MAX_ENRICHMENT_REQUESTS=4

# 以下商业接口均为可选后备，不配置也不影响免费方案运行。

# FlightAware AeroAPI v4（可选）
# 申请地址：https://www.flightaware.com/commercial/aeroapi/
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi

# Flightradar24 API（可选）
# 申请地址：https://fr24api.flightradar24.com/
FR24_API_TOKEN=
FR24_BASE_URL=https://fr24api.flightradar24.com/api

# 飞常准 VariFlight Flight Status Query V3（可选）
# APP ID、注册安全码和服务器 IP 白名单由飞常准提供。
VARIFLIGHT_APP_ID=HoyinKau
VARIFLIGHT_APP_SECURITY=sk--yHcBJzCPAWRhfjdzxHTr_3OEbBWv-NrTL8x_a7wFfQ
VARIFLIGHT_BASE_URL=https://open-al.variflight.com/api/flight
